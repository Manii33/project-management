# ---- Backend environment variables ----
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real secrets.

# --- Database (local connection) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=yourpassword
DB_DATABASE=project_management

# --- Optional: full connection URL (cloud / Railway / SSL) ---
# When set, this takes priority and enables SSL.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Auth: JWT signing secret (REQUIRED — use a long random string) ---
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# --- Server ---
PORT=3001

# --- CORS: allowed frontend origin (optional) ---
FRONTEND_URL=http://localhost:3000
